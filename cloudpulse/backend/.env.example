# Copy to .env and fill in what you need. Never commit .env.

# ---- Accounts ------------------------------------------------------------
# The first administrator. If ADMIN_PASSWORD is left empty, CloudPulse makes
# one up and prints it in the terminal on first start.
ADMIN_EMAIL=admin@cloudpulse.local
ADMIN_PASSWORD=

# One-click, read-only demo on the sign-in page (sample data only).
DEMO_ENABLED=true

# Protects stored cloud secrets. Any long random string; keep it the same
# between restarts. Generate one with:  python -c "import secrets; print(secrets.token_urlsafe(32))"
APP_SECRET_KEY=

# Set to true when the site is served over HTTPS.
COOKIE_SECURE=false

# ---- Your own cloud account (optional) --------------------------------------
# If set, CloudPulse creates a customer workspace with this name and connects it.
WORKSPACE_NAME=My Azure subscription

AZURE_SUBSCRIPTION_ID=
# Choose ONE way to sign in to Azure:
#   a) on your laptop, after `az login`:
AZURE_USE_CLI=false
#   b) a read-only service principal (scripts/azure/03-reader-identity.sh prints these):
AZURE_TENANT_ID=
AZURE_CLIENT_ID=
AZURE_CLIENT_SECRET=
#   c) on Azure App Service, the app's managed identity (04-deploy-app.sh sets this):
AZURE_USE_MANAGED_IDENTITY=false

# AWS (optional; read-only IAM user)
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=ap-south-1

# ---- Other -----------------------------------------------------------------
# Minutes between automatic syncs. AWS Cost Explorer bills $0.01 per request.
COLLECT_INTERVAL_MINUTES=360
DATABASE_URL=sqlite:///./cloudpulse.db
